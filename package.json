{
  "name": "@qa-guru/allure-report-kit",
  "version": "0.3.0",
  "description": "DX kit for Allure Report 3: theme, pluggable chart renderers, custom panels, DS report header",
  "keywords": [
    "allure",
    "allure3",
    "report",
    "charts",
    "highcharts",
    "amcharts",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "QA Guru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qa-guru/allure-report-kit.git"
  },
  "homepage": "https://github.com/qa-guru/allure-report-kit#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./allure": {
      "types": "./dist/allure/index.d.ts",
      "default": "./dist/allure/index.js"
    },
    "./theme.css": "./src/theme/kit.css",
    "./theme/*": "./src/theme/*",
    "./presets/overview-preset": "./presets/overview-preset.mjs",
    "./fixtures/quality-gate/*": "./fixtures/quality-gate/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "presets",
    "fixtures",
    "src/theme",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/build-inline.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:fork": "node scripts/typecheck-fork.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "check:kit-pin": "node scripts/check-kit-pin.mjs",
    "sync:ds": "node scripts/sync-ds.mjs",
    "sync:ds:check": "node scripts/sync-ds.mjs --check",
    "test": "node scripts/run-tests.mjs",
    "test:plain": "node --test test/*.test.mjs",
    "coverage": "node scripts/run-coverage.mjs",
    "allure:generate": "npx allure generate ./allure-results -o allure-report",
    "smoke": "node scripts/smoke-dogfood.mjs",
    "smoke:ci": "node scripts/smoke-ci.mjs",
    "smoke:allure": "node scripts/run-smoke-allure.mjs",
    "baseline": "node scripts/baseline.mjs",
    "verify": "npm run build && npm test && npm run smoke",
    "smoke:report": "node scripts/smoke-report.mjs",
    "capture:readme": "node scripts/capture-readme-gallery.mjs all",
    "smoke:single": "node scripts/smoke-single.mjs",
    "smoke:watch": "node scripts/smoke-watch.mjs",
    "build:fork": "npm --prefix packages/web-awesome run build && npm --prefix packages/web-dashboard run build",
    "report": "npm --prefix e2e run report",
    "verify:report": "npm run build && npm run build:fork && npm run report && npm run smoke:report && npm run smoke:single",
    "setup": "node scripts/setup.mjs",
    "publish:forks": "node scripts/publish-forks.mjs",
    "publish:forks:dry": "node scripts/publish-forks.mjs --dry-run",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "peerDependencies": {
    "@allurereport/charts-api": "~3.14.0",
    "highcharts": ">=11"
  },
  "peerDependenciesMeta": {
    "@amcharts/amcharts5": {
      "optional": true
    },
    "@allurereport/charts-api": {
      "optional": true
    },
    "highcharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qa-guru/allure-notifications": "6.1.1",
    "allure": "3.14.3",
    "allure-js-commons": "3.10.2",
    "allure-node-test": "3.10.2",
    "c8": "^10.1.3",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.2",
    "highcharts": "^13.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0"
  }
}
