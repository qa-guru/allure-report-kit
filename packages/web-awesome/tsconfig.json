{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "jsxImportSource": "preact",
    "target": "ESNext",
    "module": "ESNext",
    // FORK DELTA: upstream uses "node", which predates package `exports` and
    // cannot see the kit's `/allure` and `/runtime` subpaths. Webpack already
    // resolves them; this makes the type checker agree.
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2019", "dom", "dom.iterable"],
    // node types should not be used in web-commons
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  // Upstream's project reference, kept as is. It makes this a solution config,
  // which leaves fork-ts-checker inert — see soft-fork/README ("Type checking").
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
