{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "types": ["./types"]
    },
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "jsxImportSource": "preact",
    "target": "ESNext",
    "module": "ESNext",
    // FORK DELTA: upstream uses "node", which predates package `exports` and
    // cannot see the kit's `/allure` and `/runtime` subpaths. Webpack already
    // resolves them; this makes the type checker agree.
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2019", "dom"],
    // node types should not be used in web-commons
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
